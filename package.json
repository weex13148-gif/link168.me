{
  "name": "link168-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint src --quiet",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --experimental-strip-types --test src/lib/auth-credential-policy.test.ts",
    "test:console-nav": "node --experimental-strip-types --test src/components/layout/console-route-policy.test.ts",
    "test:workspace-invite": "node --experimental-strip-types --test src/lib/workspace/invitation-policy.test.ts",
    "test:workspace-resource": "node --experimental-strip-types --test src/lib/workspace/resource-policy.test.ts",
    "test:workspace-customer": "node --experimental-strip-types --test src/lib/workspace/customer-policy.test.ts",
    "test:workspace-card": "node --experimental-strip-types --test src/lib/workspace/card-policy.test.ts",
    "governance:check": "node scripts/governance/check-governance.mjs",
    "check": "npm run governance:check && npm run test:auth && npm run test:console-nav && npm run test:workspace-invite && npm run test:workspace-resource && npm run test:workspace-customer && npm run test:workspace-card && npm run lint && npm run typecheck && npm run build",
    "db:backup": "node scripts/db/backup-db.js",
    "db:restore": "node scripts/db/restore-db.js",
    "db:migrate": "node scripts/db/migrate-db.js",
    "db:verify": "node scripts/db/verify-db.js",
    "db:create-users": "node scripts/db/create-system-users.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "lucide-react": "latest",
    "next": "latest",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-qr-code": "^2.2.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "^7.8.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  },
  "optionalDependencies": {
    "@upstash/redis": "^1.38.0",
    "ioredis": "^5.11.1"
  }
}
