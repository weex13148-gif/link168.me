# 数据库连接
DATABASE_URL=postgresql://user:password@host:5432/link168

# 管理员密钥（至少 32 位随机字符串）
ADMIN_SECRET=replace-with-a-random-secret-at-least-32-characters

# 站点公网地址（用于邮件中拼接验证/重置链接）
NEXT_PUBLIC_APP_URL=https://link168.me

# ====== SMTP 邮件发送配置（必填，用于邮箱验证、重置密码等） ======
# 示例：
#   QQ 邮箱:   SMTP_HOST=smtp.qq.com,   SMTP_PORT=465
#   163 邮箱:  SMTP_HOST=smtp.163.com,  SMTP_PORT=465
#   Gmail:     SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
#   企业邮箱:  SMTP_HOST=smtp.yourdomain.com, SMTP_PORT=465
# 注意：SMTP_PASSWORD 不是邮箱登录密码，而是邮箱后台申请的"客户端授权码/应用专用密码"
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=yourname@example.com
SMTP_PASSWORD=your-smtp-app-password

# 发件人显示名称 + 地址（可与 SMTP_USER 相同）
MAIL_FROM=Link168 <yourname@example.com>
