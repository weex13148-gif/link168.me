# =========================
# Link168 server-only secrets
# =========================
# 这些变量必须只存在服务器环境中，不要写入前端页面，不要提交真实值。
# 所有值都保留为示例占位符。真实值请在服务器环境中注入。

DATABASE_URL=postgresql://username:password@hostname:5432/database_name
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-random-secret-at-least-32-characters
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# =========================
# HTTPS / Cookie security
# =========================
# 生产环境必须置为 true，确保 session / admin cookie 仅通过 HTTPS 传输。
# 本地开发可置为 false，或使用支持自签名证书的 dev 服务器。
COOKIE_SECURE=true

# 建议在反向代理（Nginx / Caddy / Cloudflare）上开启 HSTS：
# Strict-Transport-Security: max-age=31536000; includeSubDomains
# 若使用 Next.js 自己的中间件设置 HSTS，请确保服务器已启用 TLS。

# SameSite 默认严格（Lax/Strict）；若使用跨站 SSO 请按需改为 none，并同时启用 COOKIE_SECURE。
COOKIE_SAME_SITE=lax

# Persistent upload storage. Production should use an absolute path outside each release directory.
LINK168_UPLOAD_ROOT=/var/lib/link168/uploads

# =========================
# Rate limit backend
# =========================
# 可选值：memory（默认） / redis-generic（需要 ioredis） / upstash-rest（需要 @upstash/redis）
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# =========================
# Auth rate limit (jeepwork 登录)
# =========================
# WARNING: 仅用于本地开发/预览，生产环境必须为 false 或留空。
# 当 NODE_ENV !== "production" 且 AUTH_RATE_LIMIT_BYPASS=true 时，本地 15 分钟 5 次的登录限流将被跳过。
# 生产环境（NODE_ENV=production）下即使设置 AUTH_RATE_LIMIT_BYPASS=true，也会继续执行限流（该开关无效）。
# 不修改密码校验、角色校验、Session、Cookie 等任何其他认证逻辑。
# 安全策略后续（本轮暂不实现）：
#   - 前 3 次失败不显示验证码
#   - 第 4 次失败开始要求验证码
#   - 按 IP + 账号双维度限流
#   - 连续失败后短时账号锁定
#   - 超级管理员后续支持邮箱二次验证或 TOTP
#   - 所有失败登录写入审计日志
# P0: 限流绕过开关。必须同时满足 NODE_ENV !== "production" 且 AUTH_RATE_LIMIT_BYPASS=true 才会绕过限流。
# 仅限本机开发排障使用。不得在生产环境开启。
# 生产环境发现 AUTH_RATE_LIMIT_BYPASS=true 时，认证模块拒绝加载或拒绝启动。
AUTH_RATE_LIMIT_BYPASS=false

# =========================
# Database backup/restore
# =========================
# Directory for `npm run db:backup` output. Defaults to ./backups/db if unset.
BACKUP_DIR=./backups/db

# =========================
# Dangerous operation confirmations (must be set explicitly
# when running in the matching environment. NEVER commit
# =========================
# Required to run `npm run db:restore` - confirms you want to
# overwrite the current database from a backup file.
CONFIRM_RESTORE=no

# Required to run `npm run db:migrate` when NODE_ENV=production
# - confirms you accept schema changes against live data.
CONFIRM_PRODUCTION_MIGRATE=no

# =========================
# Optional system users
# =========================
# Used by `npm run db:create-users`
# If left unset, strong random passwords will be generated.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=replace-with-strong-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-password

# =========================
# Optional SMTP fallback
# =========================
# 正式产品规则：第三方 API / SMTP / 支付 / 存储 / 短信配置优先通过超级管理员配置中心填写。
# 如需保留环境变量方式做服务器应急兜底，可使用以下占位项，但不要提交真实值。

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailbox@example.com
SMTP_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=Link168 <no-reply@example.com>

# =========================
# AI / Bailian application
# =========================
# Enterprise AI chat uses Bailian application interface.
# Configure these on the server, or override them in the admin AI settings UI.
BAILIAN_APP_ID=replace-with-bailian-app-id
BAILIAN_APP_BASE_URL=https://api-provider.example.com/v1
DASHSCOPE_WORKSPACE_ID=

# =========================
# Alipay reconciliation cron
# =========================
# 用于保护 /api/internal/cron/reconcile-alipay。
# 必须使用至少 32 位随机值，只存在于服务器和定时任务请求头中。
# 调用时可使用 Authorization: Bearer <secret> 或 x-cron-secret: <secret>。
PAYMENT_RECONCILE_SECRET=replace-with-a-random-secret-at-least-32-characters

# =========================
# Notes
# =========================
# 1. DATABASE_URL / SESSION_SECRET / ADMIN_SECRET / CONFIG_ENCRYPTION_KEY
#    只能由服务器环境变量提供，不能通过网页后台配置。
# 2. 超级管理员配置中心会对敏感字段加密保存，并只返回脱敏值。
# 3. 第三方 API Key 建议通过超级管理员配置中心填写，不要写入源码或提交到仓库。
# 4. 不要提交 .sql / .sql.gz 备份文件到 Git（.gitignore 已保护）。
# 5. PAYMENT_RECONCILE_SECRET 不得通过网页后台保存，不得提交真实值。
