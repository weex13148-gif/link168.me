generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String                   @id @db.Uuid
  email         String                   @unique
  passwordHash  String                   @map("password_hash")
  emailVerified Boolean                  @default(false) @map("email_verified")
  role          String                   @default("user")
  isSystem      Boolean                  @default(false) @map("is_system")
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile       Profile?
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  verifyTokens  EmailVerificationToken[]
  aiUsageLogs   AiUsageLog[]

  @@map("users")
}

model Profile {
  id          String   @id @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  username    String   @unique
  displayName String?  @map("display_name")
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  theme       String   @default("default")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  links       Link[]

  @@map("profiles")
}

model Link {
  id          String   @id @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  title       String
  url         String
  description String?
  iconUrl     String?  @map("icon_url")
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("links")
}

model Session {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  lastActive DateTime @default(now()) @map("last_active") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Report {
  id           String   @id @db.Uuid
  reportUrl    String   @map("report_url")
  reportType   String   @map("report_type")
  reportReason String   @map("report_reason")
  contact      String?
  imageUrl     String?  @map("image_url")
  status       String   @default("待处理")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("reports")
}

model PasswordResetToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model LoginAttempt {
  id        String    @id @db.Uuid
  email     String
  ipAddress String    @map("ip_address")
  success   Boolean
  locked    Boolean   @default(false)
  lockUntil DateTime? @map("lock_until") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model AppConfig {
  id          String   @id @db.Uuid
  configKey   String   @unique @map("config_key")
  configValue String   @map("config_value")
  isSensitive Boolean  @default(false) @map("is_sensitive")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("app_configs")
}

model AiUsageLog {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  assistant String
  usageDate DateTime @map("usage_date") @db.Date
  callCount Int      @default(0) @map("call_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assistant, usageDate])
  @@index([userId, usageDate])
  @@map("ai_usage_logs")
}
