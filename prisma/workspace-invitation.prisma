// V2 Workspace 邮箱邀请模型。
// 邀请记录与最终 WorkspaceMember 成员资格分离：接受前没有企业数据访问权。
model WorkspaceInvitation {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  email              String
  // admin / member / viewer；owner 不允许通过邀请授予
  role               String    @default("member")
  tokenHash          String    @unique @map("token_hash")
  // pending / accepted / revoked / expired / delivery_failed
  status             String    @default("pending")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  invitedByUserId    String    @map("invited_by_user_id") @db.Uuid
  acceptedByUserId   String?   @map("accepted_by_user_id") @db.Uuid
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz(6)
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveryErrorCode  String?   @map("delivery_error_code")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, status, createdAt])
  @@index([email, status, expiresAt])
  @@index([invitedByUserId, createdAt])
  @@map("workspace_invitations")
}
